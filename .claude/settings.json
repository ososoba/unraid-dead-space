{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)"
    ],
    "allow": [
      "Read(./.env.example)",
      "Edit(./.env.example)",
      "Write(./.env.example)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash|Grep|Glob|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/block-env-access.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
