# Dead Movies & Shows — environment template
# Copy to .env and fill in. Never commit .env.

# ---------- Auth ----------
APP_USERNAME=admin
APP_PASSWORD_HASH=        # bcrypt hash; generate with: python -m dms.cli.hash_password
SESSION_SECRET=            # random 32+ char string
COOKIE_SECURE=false        # false: works on both LAN HTTP and tunnel HTTPS
SESSION_DAYS=90

# ---------- Unraid / runtime ----------
PUID=99
PGID=100
TZ=America/Toronto

# ---------- Sync ----------
SYNC_CRON=0 4 * * *
SYNC_MAX_CONCURRENCY=4
HTTP_TIMEOUT_SECONDS=30
BACKFILL_PAGE_SIZE=500
SYNC_LOCK_TTL_MINUTES=120

# ---------- Watch logic ----------
WATCH_SCOPE=anyone                # anyone | requester
WATCH_THRESHOLD_MOVIES_PCT=80
WATCH_THRESHOLD_EPISODES_PCT=80
SERIES_SPECIALS_MODE=ignore       # ignore | include
NEVER_WATCHED_DAYS=90
STALE_DAYS=180
HISTORY_RETENTION_YEARS=10

# ---------- Sonarr instances ----------
SONARR_1_NAME=Sonarr 1080p
SONARR_1_URL=http://192.168.1.10:8989
SONARR_1_API_KEY=

SONARR_2_NAME=Sonarr 4K
SONARR_2_URL=http://192.168.1.10:8990
SONARR_2_API_KEY=

# ---------- Radarr instances ----------
RADARR_1_NAME=Radarr 1080p
RADARR_1_URL=http://192.168.1.10:7878
RADARR_1_API_KEY=

RADARR_2_NAME=Radarr 4K
RADARR_2_URL=http://192.168.1.10:7879
RADARR_2_API_KEY=

# ---------- Tautulli ----------
TAUTULLI_URL=http://192.168.1.10:8181
TAUTULLI_API_KEY=

# ---------- Request services ----------
# Multiple instances supported. Each can be a different flavor
# (overseerr | seerr | jellyseerr) — handy during the Overseerr → Seerr migration.
# Earliest request per media wins for attribution across all instances.
REQUESTER_1_SOURCE=overseerr
REQUESTER_1_NAME=Overseerr 1080p
REQUESTER_1_URL=http://192.168.1.10:5055
REQUESTER_1_API_KEY=

REQUESTER_2_SOURCE=overseerr
REQUESTER_2_NAME=Overseerr 4K
REQUESTER_2_URL=http://192.168.1.10:5056
REQUESTER_2_API_KEY=
